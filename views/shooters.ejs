<%- include('partials/head') %>
<h1>Shooters</h1>
<p class="muted">Add an email address for any shooter. After each uploaded shoot, every shooter with an address is emailed their own results: position, score, stand by stand, how it compares with their recent average, and the top of the field. Only add addresses with the shooter's agreement.</p>

<% if (msg) { %><p><span class="badge ok"><%= msg %></span></p><% } %>
<% if (err) { %><p><span class="badge warn"><%= err %></span></p><% } %>
<% if (!configured) { %><p><span class="badge warn">Outgoing email is not set up yet: add the SMTP_ settings to .env and restart.</span></p><% } %>

<section class="card">
  <form method="post" action="/shooters/auto" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="auto" value="<%= auto ? '0' : '1' %>">
    Automatic emails after each upload: <span class="badge <%= auto ? 'ok' : 'warn' %>"><%= auto ? 'On' : 'Off' %></span>
    <button class="btn small secondary"><%= auto ? 'Turn off' : 'Turn on' %></button>
  </form>
</section>

<section class="card" id="roster">
  <h2>Roster</h2>
  <p class="muted">Registered shooters for this club. The iPhone app lists <span class="tag-member">members</span> and <span class="tag-guest">guests</span> that are current; <span class="tag-expired">expired</span> members are kept for their past shoots but are not offered to the app. Shooters added from the app arrive as guests.</p>
  <form method="post" action="/shooters/roster/add" class="social-actions">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="name" maxlength="60" placeholder="Name" required aria-label="Name">
    <input type="email" name="email" maxlength="200" placeholder="name@example.com" required aria-label="Email">
    <select name="kind" aria-label="Member or guest"><option value="member">Member</option><option value="admin">Admin (also a member)</option><option value="guest">Guest</option></select>
    <button class="btn small">Add to roster</button>
  </form>
  <% if (roster.length) { %>
  <table class="results-table social-table">
    <thead><tr><th>Name</th><th>Email</th><th>Type</th><th></th></tr></thead>
    <tbody>
      <% roster.forEach(r => { const cls = r.status === 'expired' ? 'tag-expired' : (r.kind === 'member' ? 'tag-member' : 'tag-guest'); %>
        <tr>
          <th scope="row"><span class="<%= cls %>"><%= r.name %></span></th>
          <td><%= r.email %></td>
          <td><span class="<%= cls %>"><%= r.status === 'expired' ? 'Expired ' + r.kind : (r.kind === 'member' ? 'Member' : 'Guest') %></span><% if (r.is_admin) { %> <span class="badge ok">Admin</span><% } %></td>
          <td class="social-actions">
            <% if (r.status === 'current') { %>
              <form method="post" action="/shooters/roster/<%= r.id %>/kind" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="kind" value="<%= r.kind === 'member' ? 'guest' : 'member' %>"><button class="btn small secondary">Make <%= r.kind === 'member' ? 'guest' : 'member' %></button></form>
              <% if (r.kind === 'member') { %>
              <form method="post" action="/shooters/roster/<%= r.id %>/admin" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="admin" value="<%= r.is_admin ? '0' : '1' %>"><button class="btn small secondary"><%= r.is_admin ? 'Remove admin' : 'Make admin' %></button></form>
              <form method="post" action="/shooters/roster/<%= r.id %>/status" class="inline" data-confirm="Mark this membership as expired? They will no longer be offered in the app."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="expired"><button class="btn small secondary">Expire membership</button></form>
              <% } %>
            <% } else { %>
              <form method="post" action="/shooters/roster/<%= r.id %>/status" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="current"><button class="btn small secondary">Reinstate</button></form>
            <% } %>
            <form method="post" action="/shooters/roster/<%= r.id %>/delete" class="inline" data-confirm="Remove from the roster? Past results are kept."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small danger">Remove</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %><p class="muted">No shooters on the roster yet.</p><% } %>
</section>

<h2>Results and emails</h2>
<% if (!shooters.length) { %>
  <p class="muted">No shooters yet. They appear here after the first upload.</p>
<% } else { %>
  <table class="results-table social-table">
    <thead><tr><th>Shooter</th><th>Shoots</th><th>Email</th><th>Last email</th><th></th></tr></thead>
    <tbody>
      <% shooters.forEach(s => { %>
        <tr>
          <th scope="row"><span<%- shooterAttrs(s.name) %>><%= s.name %></span></th>
          <td><%= s.shoots %></td>
          <td>
            <form method="post" action="/shooters/email" class="social-actions">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="name" value="<%= s.name %>">
              <input type="email" name="email" maxlength="200" value="<%= s.rec ? s.rec.email : '' %>" placeholder="name@example.com" aria-label="Email for <%= s.name %>">
              <button class="btn small secondary">Save</button>
            </form>
          </td>
          <td><%= s.rec && s.rec.last_status ? s.rec.last_status : '' %><% if (s.rec && s.rec.last_at) { %> <span class="muted">(<%= s.rec.last_at %> UTC)</span><% } %></td>
          <td>
            <% if (s.rec) { %>
              <form method="post" action="/shooters/send" class="social-actions">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="name" value="<%= s.name %>">
                <button class="btn small secondary">Send latest results</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('partials/foot') %>
