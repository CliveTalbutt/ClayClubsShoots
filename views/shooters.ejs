<%- include('partials/head') %>
<h1>Shooters</h1>
<p class="muted">Add an email address for any shooter. After each uploaded shoot, every shooter with an address is emailed their own results: position, score, stand by stand, how it compares with their recent average, and the top of the field. Only add addresses with the shooter's agreement.</p>

<% if (msg) { %><p><span class="badge ok"><%= msg %></span></p><% } %>
<% if (err) { %><p><span class="badge warn"><%= err %></span></p><% } %>
<% if (!configured) { %><p><span class="badge warn">Outgoing email is not set up yet: add the SMTP_ settings to .env and restart.</span></p><% } %>

<section class="card">
  <form method="post" action="/shooters/auto" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="auto" value="<%= auto ? '0' : '1' %>">
    Automatic emails after each upload: <span class="badge <%= auto ? 'ok' : 'warn' %>"><%= auto ? 'On' : 'Off' %></span>
    <button class="btn small secondary"><%= auto ? 'Turn off' : 'Turn on' %></button>
  </form>
</section>

<section class="card" id="roster">
  <h2>Membership</h2>
  <% if (allowance && allowance.limited) { %>
  <p>Places used: <strong><%= allowance.usedMembers %> of <%= allowance.members %></strong> members, <strong><%= allowance.usedGuests %> of <%= allowance.guests %></strong> guests.
    <% if (allowance.usedMembers >= allowance.members || allowance.usedGuests >= allowance.guests) { %><span class="badge warn">At the limit</span> <a href="/dashboard#subscription">Increase your allowance</a><% } %></p>
  <% } %>
  <p class="muted">Registered shooters for this club. The iPhone app lists <span class="tag-member">members</span> and <span class="tag-guest">guests</span> that are current; <span class="tag-expired">expired</span> members are kept for their past shoots but are not offered to the app. Shooters added from the app arrive as guests.</p>
  <form method="post" id="roster-form" action="/shooters/roster/add" class="social-actions roster-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <strong data-form-title>New member</strong>
    <input name="name" maxlength="60" placeholder="Name" required aria-label="Name">
    <input type="email" name="email" maxlength="200" placeholder="name@example.com" aria-label="Email (required for members)">
    <select name="kind" aria-label="Member or guest"><option value="member">Member</option><option value="admin">Admin</option><option value="guest">Guest</option></select>
    <label class="muted" data-guest-only hidden><input type="checkbox" name="signedGuestBook" value="on"> Has signed the guest book</label>
    <select name="status" aria-label="Membership status" data-edit-only hidden disabled><option value="current">Current</option><option value="expired">Expired</option></select>
    <button class="btn small" data-form-submit>Add to membership</button>
    <button type="button" class="btn small secondary" data-form-cancel hidden>Cancel</button>
    <button class="btn small danger" form="roster-delete" data-form-remove hidden>Remove member</button>
    <span class="muted" data-edit-guid></span>
  </form>
  <form method="post" id="roster-delete" class="inline" data-confirm="Remove this member from the membership? Past results are kept. This cannot be undone.">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
  </form>
  <% if (roster.length) { %>
  <table class="results-table social-table">
    <thead><tr><th>Name</th><th>Shoots</th><th>Email</th><th>Type</th><th>Guest book signed</th></tr></thead>
    <tbody>
      <% roster.forEach(r => { const cls = r.status === 'expired' ? 'tag-expired' : (r.kind === 'member' ? 'tag-member' : 'tag-guest'); %>
        <tr class="roster-row" data-edit="<%= JSON.stringify({ id: r.id, guid: r.guid, name: r.name, email: r.email, kind: r.is_admin ? 'admin' : r.kind, status: r.status, signed: r.signed_guest_book === 1 }) %>">
          <th scope="row"><span class="<%= cls %>"<%- shooterAttrs(r.name) %>><%= r.name %></span></th>
          <td><% if (r.shoots) { %><button type="button" class="btn small secondary" data-attend="attend-<%= r.id %>"><%= r.shoots %></button>
            <dialog id="attend-<%= r.id %>" class="attend-dialog"><h3><%= r.name %> &ndash; <%= r.shoots %> shoot<%= r.shoots === 1 ? '' : 's' %></h3>
              <table><thead><tr><th>Date</th><th>Shoot</th><th>Venue</th></tr></thead><tbody>
              <% r.attended.forEach(a => { %><tr><td><%= a.shoot_date.slice(0, 16).replace('T', ' ') %></td><td><a href="/shoots/<%= eid(a.id) %>"><%= a.name %></a></td><td><%= a.venue || '' %></td></tr><% }) %>
              </tbody></table>
              <form method="dialog"><button class="btn small">Close</button></form></dialog>
          <% } else { %>0<% } %></td>
          <td><%= r.email %>
            <% if (!r.email) { %> <span class="muted">none</span>
            <% } else if (r.email_verified_at) { %> <span class="badge ok" title="Verified <%= r.email_verified_at %> UTC">&#10003; Verified</span>
            <% } else { %> <span class="badge warn">Unverified</span>
              <form method="post" action="/shooters/roster/<%= r.id %>/verify" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small secondary"><%= r.verify_sent_at ? 'Resend' : 'Verify' %></button></form>
            <% } %></td>
          <td><span class="<%= cls %>"><%= r.status === 'expired' ? 'Expired ' + r.kind : (r.kind === 'member' ? 'Member' : 'Guest') %></span><% if (r.is_admin) { %> <span class="badge ok">Admin</span><% } %></td>
          <td class="guest-book"><% if (r.kind === 'guest') { %><% if (r.signed_guest_book) { %><span class="gb-yes" role="img" aria-label="Signed" title="Signed">&#10003;</span><% } else { %><span class="gb-no" role="img" aria-label="Not signed" title="Not signed">&#10007;</span><% } %><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %><p class="muted">No shooters in the membership yet.</p><% } %>
</section>

<script src="/attend.js" defer></script>
<script src="/roster-edit.js" defer></script>
<%- include('partials/foot') %>
