<%- include('partials/head') %>
<h1><%= user.club_name %></h1>

<% if (realSuper) { %>
<section class="card">
  <h2>Shoot clubs</h2>
  <p class="muted">See every shoot club, its accounts, shoots and shooters, and open any club as its user.</p>
  <a class="btn" href="/admin/clubs">Manage shoot clubs</a>
</section>
<% } %>

<% if (user.is_super === 1 || userRole === 'Admin') { %>
<section class="card" id="subscription">
  <h2>Subscription</h2>
  <% const msgs = { ok: ['ok', 'Payment received. Thank you!'], pending: ['warn', 'Payment started. Access will switch on as soon as the provider confirms it.'], failed: ['warn', 'Sorry, that payment could not be started or confirmed. Please try again or use another method.'], cancelled: ['warn', 'Payment cancelled.'], requested: ['ok', 'Allowance updated. Pay below to switch it on.'], badsize: ['warn', 'That allowance was not accepted.'], welcome: ['ok', 'Welcome to Clay Shoots! Choose a plan below to start recording shoots.'] }; %>
  <% if (payStatus && msgs[payStatus]) { %><p><span class="badge <%= msgs[payStatus][0] %>"><%= msgs[payStatus][1] %></span> <%= payMsg || '' %></p><% } %>
  <% if (!payOptions.length) { %>
    <p><span class="badge ok">Active</span> No payment provider is configured, so every account has full access.</p>
  <% } else { %>
    <% if (active) { %>
      <p><span class="badge ok">Active</span> Paid until <%= new Date(user.sub_period_end * 1000).toLocaleDateString('en-GB') %></p>
      <% if (hasPortal) { %><form method="post" action="/billing/portal"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary">Manage card subscription</button></form><% } %>
      <h3>Extend or renew</h3>
    <% } else { %>
      <p><span class="badge warn">Inactive</span> Choose a plan to upload and record shoots.</p>
    <% } %>
    <% if (allowance.limited) { %>
    <div class="allowance">
      <h3>Your allowance</h3>
      <p>Covers <strong><%= allowance.members %> member<%= allowance.members === 1 ? '' : 's' %></strong> and <strong><%= allowance.guests %> guest<%= allowance.guests === 1 ? '' : 's' %></strong> (<%= allowance.price %> per annum). In use: <%= allowance.usedMembers %> members, <%= allowance.usedGuests %> guests.
        <% if (allowance.usedMembers >= allowance.members || allowance.usedGuests >= allowance.guests) { %><span class="badge warn">At the limit</span><% } %></p>
      <form method="post" action="/billing/allowance" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Members <input type="number" name="members" id="est-members" min="<%= Math.max(1, allowance.usedMembers) %>" max="5000" value="<%= allowance.nextMembers %>" required></label>
        <label>Guests <input type="number" name="guests" id="est-guests" min="<%= allowance.usedGuests %>" max="5000" value="<%= allowance.nextGuests %>" required></label>
        <span>= <strong id="est-price">&pound;0.00</strong> per annum</span>
        <button class="btn small secondary">Update allowance</button>
      </form>
      <p class="muted">&pound;1 per member and 50p per guest, per annum. A bigger allowance is charged pro rata for the rest of this year; a smaller one applies at renewal. It takes effect once paid.</p>
      <% if (allowance.pending) { %><p><span class="badge warn">Awaiting payment</span> Requested: <%= allowance.nextMembers %> members, <%= allowance.nextGuests %> guests (<%= allowance.nextPrice %> per annum).</p><% } %>
    </div>
    <script src="/estimate.js" defer></script>
    <% } %>
    <div class="plans">
      <% payOptions.forEach(plan => { %>
        <div class="plan">
          <h3><%= plan.label %></h3>
          <p class="plan-price"><strong><%= plan.price %></strong> <span class="muted"><%= plan.blurb %></span></p>
          <% plan.providers.forEach(p => { %>
            <form method="post" action="/billing/pay/<%= p.id %>">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="plan" value="<%= plan.key %>">
              <button class="btn <%= active ? 'secondary' : '' %> pay-btn">Pay with <%= p.name %></button>
            </form>
          <% }) %>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
<% } %>

<% if (user.is_super === 1) { %>

<section class="card">
  <h2>API key</h2>
  <% if (newKey) { %>
    <p>Copy this now &ndash; it won't be shown again:</p>
    <pre><code><%= newKey %></code></pre>
  <% } %>
  <p class="muted">Send results with <code>POST <%= baseUrl %>/api/v1/shoots</code> and header <code>Authorization: Bearer &lt;key&gt;</code>. Generating a new key revokes the old one.</p>
  <form method="post" action="/settings/api-key"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary">Generate new API key</button></form>
  <details>
    <summary>JSON format</summary>
<pre><code>{
  "name": "Sunday Sporting",
  "venue": "Green Valley CPSA",
  "date": "2026-05-17",
  "externalId": "optional-unique-id-from-app",
  "stands": 6,
  "targetsPerStand": 10,
  "shooters": [
    { "name": "A. Smith", "scores": [8, 9, 7, 10, 6, 8] }
  ]
}</code></pre>
  </details>
</section>
<% } %>

<section class="card">
  <div class="row"><h2>Shoots</h2>
    <form id="bulk-delete" method="post" action="/shoots/delete-selected" data-confirm="Delete the selected shoots and all their results? This cannot be undone." hidden><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small danger">Delete selected (<span id="bulk-count">0</span>)</button></form>
  </div>
  <% if (!shoots.length) { %><p class="muted">No shoots yet.</p><% } else { %>
  <input type="search" id="shoot-search" placeholder="Search shoots by name, venue or date" aria-label="Search shoots">
  <table id="shoots-table">
    <thead><tr><th><input type="checkbox" id="select-all" aria-label="Select all shown shoots"></th><th><button type="button" class="sort-button" data-sort="0" data-type="text">Date <span class="sort-indicator" aria-hidden="true"></span></button></th><th><button type="button" class="sort-button" data-sort="1" data-type="text">Shoot <span class="sort-indicator" aria-hidden="true"></span></button></th><th><button type="button" class="sort-button" data-sort="2" data-type="text">Venue <span class="sort-indicator" aria-hidden="true"></span></button></th><th><button type="button" class="sort-button" data-sort="3" data-type="number">Stands <span class="sort-indicator" aria-hidden="true"></span></button></th><th><button type="button" class="sort-button" data-sort="4" data-type="number">Shooters <span class="sort-indicator" aria-hidden="true"></span></button></th><th></th></tr></thead>
    <tbody>
    <% shoots.forEach(s => { %>
      <tr><td><input type="checkbox" class="shoot-select" form="bulk-delete" name="ids" value="<%= eid(s.id) %>" aria-label="Select shoot"></td><td data-v="<%= s.shoot_date %> <%= s.shoot_time || '' %>"><%= when(s) %></td><td><a href="/shoots/<%= eid(s.id) %>"><%= s.name %></a></td><td><%= s.venue || '' %></td><td><%= s.stands %></td><td><%= s.shooters %></td><td><form method="post" action="/shoots/<%= eid(s.id) %>/delete" class="inline" data-confirm="Delete this shoot and all its results? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="from" value="/dashboard"><button class="btn small danger">Delete</button></form></td></tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</section>
<script src="/bulk-select.js" defer></script>
<%- include('partials/foot') %>
