<%- include('partials/head') %>
<div class="row">
  <div><h1><%= shoot.name %></h1><p class="muted"><%= when(shoot) %><%= shoot.venue ? ' · ' + shoot.venue : '' %> · <%= shoot.stands %> stands × <%= shoot.targets_per_stand %></p></div>
  <form method="post" action="/shoots/<%= eid(shoot.id) %>/delete" data-confirm="Delete this shoot and all its results? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small danger">Delete</button></form>
</div>
<section class="card">
  <table>
    <thead><tr>
      <th><a href="?sort=name">Shooter</a></th>
      <% for (let i = 1; i <= shoot.stands; i++) { %><th class="num">S<%= i %><% if (lockedStands.includes(i)) { %> <span role="img" aria-label="locked" title="Stand locked">🔒</span><% } %></th><% } %>
      <th class="num"><a href="?sort=total">Total / <%= max %></a></th>
    </tr></thead>
    <tbody>
    <% shooters.forEach(s => { %>
      <tr><td><span<%- shooterAttrs(s.name) %>><%= s.name %></span></td>
        <% s.scores.forEach(v => { %><td class="num"><%= v ?? '–' %></td><% }) %>
        <td class="num"><strong><%= shoot.is_handicap ? s.net : s.total %></strong><% if (shoot.is_handicap) { %> <small title="Total less handicap">(<%= s.total %> − <%= s.handicap %>)</small><% } %></td></tr>
    <% }) %>
    </tbody>
  </table>
</section>
<p><a href="/dashboard">Back</a></p>
<%- include('partials/foot') %>
