<%- include('partials/head') %>
<form method="post" class="card narrow">
  <h2>Set up two-factor authentication</h2>
  <p class="muted">Scan with an authenticator app (1Password, Google Authenticator, Authy), then enter the 6-digit code.</p>
  <img class="qr" src="<%= qr %>" alt="2FA QR code">
  <p class="muted">Manual key: <code><%= secret %></code></p>
  <% if (typeof error !== 'undefined' && error) { %><p class="error"><%= error %></p><% } %>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>6-digit code<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" required></label>
  <button class="btn">Verify &amp; finish</button>
</form>
<%- include('partials/foot') %>
