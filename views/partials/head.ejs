<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Clay Shoots</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="nav">
  <a class="brand" href="/">&#9678; Clay Shoots</a>
  <% if (user) { %><span class="nav-user" title="<%= user.email %>"><% if (currentShoot) { %><span class="nav-shoot" title="Current shoot"><%= currentShoot %></span> &middot; <% } %><%= user.email %> <span class="role-badge"><%= userRole %></span></span><% } %>
  <nav>
    <% if (user) { %>
      <% if (realSuper) { %><a href="/admin/clubs">Shoot clubs</a><% } %>
      <div class="nav-menu">
        <a href="/dashboard">Dashboard &#9662;</a>
        <div class="nav-sub">
          <a href="/results">Results</a>
          <a href="/leaderboard">Leaderboard</a>
        </div>
      </div>
      <div class="nav-menu nav-menu-right">
        <a href="/account" class="nav-account" title="Signed in as <%= user.email %>">Account &#9662;</a>
        <div class="nav-sub">
          <a href="/shooters">Shooters</a>
          <a href="/social">Social</a>
          <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="nav-signout">Sign out</button></form>
        </div>
      </div>
    <% } else { %>
      <a href="/login">Sign in</a>
      <a class="btn small" href="/register">Create account</a>
    <% } %>
  </nav>
</header>
<% if (acting) { %><div class="acting-banner">Viewing as <strong><%= user.club_name %></strong> (<%= user.email %>, <%= userRole %>)
  <form method="post" action="/admin/return"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="btn small">Back to super admin</button></form></div><% } %>
<main>
