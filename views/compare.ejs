<%- include('partials/head') %>
<% const sortState = key => {
  const index = sortOrder.findIndex(item => item.key === key);
  return index === -1 ? { index, direction: null, indicator: '↕' } : {
    index,
    direction: sortOrder[index].direction,
    indicator: `${sortOrder[index].direction === 'asc' ? '↑' : '↓'} ${index + 1}`
  };
}; %>
<h1>Compare shoots</h1>
<form method="get" class="card" id="compare-form">
  <p class="muted">Select shoots and click column headings to configure sort priority. Click again to reverse; click a third time to remove.</p>
  <div class="checks">
  <% all.forEach(s => { %>
    <label class="check"><input type="checkbox" name="ids" value="<%= eid(s.id) %>" <%= ids.includes(s.id) ? 'checked' : '' %>> <%= s.shoot_date %> &ndash; <%= s.name %></label>
  <% }) %>
  </div>
  <% if (sortOrder.length) { %>
    <% sortOrder.forEach(item => { %><input type="hidden" name="sort" value="<%= item.key %>:<%= item.direction %>"><% }) %>
  <% } else { %>
    <input type="hidden" name="sort" value="none">
  <% } %>
</form>

<section class="card">
  <% if (!shooters.length) { %><p class="muted">No results selected.</p><% } else { %>
  <table>
    <thead><tr><th><% const state = sortState('name'); %><button type="button" class="sort-button" data-sort-key="name" aria-label="Sort by shooter name" title="Sort by shooter name"><span>Shooter</span><span class="sort-indicator"><%= state.indicator %></span></button></th>
      <% selected.forEach(s => { const key = `shoot-${eid(s.id)}`; const state = sortState(key); %><th class="num" title="<%= s.name %>"><button type="button" class="sort-button" data-sort-key="<%= key %>" aria-label="Sort by <%= s.name %>" title="Sort by <%= s.name %>"><span><%= s.shoot_date.slice(5) %></span><span class="sort-indicator"><%= state.indicator %></span></button></th><% }) %>
      <th class="num"><% const totalState = sortState('total'); %><button type="button" class="sort-button" data-sort-key="total" aria-label="Sort by total score" title="Sort by total score"><span>Total</span><span class="sort-indicator"><%= totalState.indicator %></span></button></th>
      <th class="num"><% const pctState = sortState('pct'); %><button type="button" class="sort-button" data-sort-key="pct" aria-label="Sort by average percentage" title="Sort by average percentage"><span>Avg %</span><span class="sort-indicator"><%= pctState.indicator %></span></button></th></tr></thead>
    <tbody>
    <% shooters.forEach(s => { %>
      <tr><td><span<%- shooterAttrs(s.name) %>><%= s.name %></span></td>
        <% selected.forEach(sh => { %><td class="num"><%= s.per[sh.id] ?? '–' %></td><% }) %>
        <td class="num"><strong><%= s.total %></strong></td><td class="num"><%= s.pct.toFixed(1) %>%</td></tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</section>
<script src="/compare.js" defer></script>
<%- include('partials/foot') %>
