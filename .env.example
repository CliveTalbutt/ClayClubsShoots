PORT=3000
BASE_URL=http://localhost:3000
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32  (encrypts 2FA secrets at rest)
APP_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of a £50 / year recurring price
STRIPE_PRICE_ID=

# ---- Payments (leave blank to disable a provider; with none set every account has full access) ----
CURRENCY=GBP
PRICE_MONTHLY_PENCE=500
PRICE_ANNUAL_PENCE=5000
# Stripe: cards, Apple Pay, Google Pay (webhook: /webhook/stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal (PAYPAL_ENV=sandbox|live). PAYPAL_PLAN_ID is a monthly billing plan created in PayPal; without it only the annual pass is offered.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
# GoCardless Direct Debit (GOCARDLESS_ENV=sandbox|live, webhook: /webhook/gocardless)
GOCARDLESS_ENV=sandbox
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
# Square (SQUARE_ENV=sandbox|live, webhook: /webhook/square). Annual pass only.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Mollie (a test_ key is sandbox, webhook: /webhook/mollie)
MOLLIE_API_KEY=
